generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid
  username String @unique
  passwordHash String
  singleton Int @unique @default(1)
  sessions Session[]
}

model Session {
  tokenHash String @id
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
}

model BankConnection {
  id String @id @default(uuid()) @db.Uuid
  name String
  bankCode String
  connectorType String
  username String?
  status String @default("ACTIVE")
  metadata Json?
  leaseUntil DateTime?
  accounts Account[]
  runs ImportRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id String @id @default(uuid()) @db.Uuid
  bankConnectionId String @db.Uuid
  bankConnection BankConnection @relation(fields: [bankConnectionId], references: [id])
  name String
  iban String?
  bankAccountReference String?
  currency String @default("EUR")
  accountType String @default("CHECKING")
  isActive Boolean @default(true)
  lastSuccessfulSyncAt DateTime?
  cursorDate DateTime? @db.Date
  balances BalanceSnapshot[]
  transactions Transaction[]
  staged StagedRow[]
  @@unique([bankConnectionId, bankAccountReference])
}

model BalanceSnapshot {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id])
  amountCents BigInt
  balanceType String
  observedAt DateTime
  source String
  importRunId String @db.Uuid
  importRun ImportRun @relation(fields: [importRunId], references: [id])
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  kind String
  color String?
  isSystem Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  transactions Transaction[]
}

model Transaction {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id])
  amountCents BigInt
  currency String @default("EUR")
  bookingDate DateTime @db.Date
  valueDate DateTime? @db.Date
  description String
  counterpartyName String?
  counterpartyIban String?
  status String @default("BOOKED")
  categoryId String? @db.Uuid
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isTransfer Boolean @default(false)
  transferGroupId String? @db.Uuid
  transferGroup TransferGroup? @relation(fields: [transferGroupId], references: [id], onDelete: SetNull)
  identities TransactionIdentity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([accountId, bookingDate(sort: Desc), id(sort: Desc)])
  @@index([categoryId])
}

model TransactionIdentity {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  identityType String
  identityValue String
  transactionId String @db.Uuid
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  @@unique([accountId, identityType, identityValue])
}

model TransferGroup {
  id String @id @default(uuid()) @db.Uuid
  transactions Transaction[]
}

model ImportRun {
  id String @id @default(uuid()) @db.Uuid
  bankConnectionId String? @db.Uuid
  bankConnection BankConnection? @relation(fields: [bankConnectionId], references: [id])
  source String
  status String @default("CREATED")
  startedAt DateTime @default(now())
  finishedAt DateTime?
  importedCount Int @default(0)
  knownCount Int @default(0)
  reviewRequiredCount Int @default(0)
  errorCode String?
  issues ImportIssue[]
  staged StagedRow[]
  balances BalanceSnapshot[]
  @@index([startedAt])
}

model ImportIssue {
  id String @id @default(uuid()) @db.Uuid
  runId String @db.Uuid
  run ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rowNumber Int?
  code String
  message String
  candidateIds String[]
  resolved Boolean @default(false)
  stagedRowId String? @unique @db.Uuid
  stagedRow StagedRow? @relation(fields: [stagedRowId], references: [id], onDelete: SetNull)
}

model StagedRow {
  id String @id @default(uuid()) @db.Uuid
  runId String @db.Uuid
  run ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  accountId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id])
  rowNumber Int
  data Json
  issue ImportIssue?
}
