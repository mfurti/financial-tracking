generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid
  username String @unique
  passwordHash String
  singleton Int @unique @default(1)
  sessions Session[]
  profile OwnerProfile?
  notificationAcknowledgements NotificationAcknowledgement[]
}

model OwnerProfile {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String @db.VarChar(80)
  contactEmail String? @db.VarChar(254)
  updatedAt DateTime @updatedAt
}

model AccountGroup {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(60)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members AccountGroupMember[]
}

model AccountGroupMember {
  groupId String @db.Uuid
  accountId String @db.Uuid
  group AccountGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@id([groupId, accountId])
  @@index([accountId])
}

model NotificationAcknowledgement {
  userId String @db.Uuid
  sourceKey String @db.VarChar(256)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime @default(now())
  @@id([userId, sourceKey])
}

model Session {
  tokenHash String @id
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
}

model BankConnection {
  id String @id @default(uuid()) @db.Uuid
  name String
  bankCode String
  connectorType String
  username String?
  status String @default("ACTIVE")
  metadata Json?
  leaseUntil DateTime?
  accounts Account[]
  runs ImportRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id String @id @default(uuid()) @db.Uuid
  bankConnectionId String @db.Uuid
  bankConnection BankConnection @relation(fields: [bankConnectionId], references: [id])
  name String
  iban String?
  bankAccountReference String?
  currency String @default("EUR")
  accountType String @default("CHECKING")
  isActive Boolean @default(true)
  lastSuccessfulSyncAt DateTime?
  cursorDate DateTime? @db.Date
  balances BalanceSnapshot[]
  transactions Transaction[]
  staged StagedRow[]
  contracts Contract[]
  presentation AccountPresentation?
  wealthComponents WealthRecordComponent[]
  groupMemberships AccountGroupMember[]
  @@unique([bankConnectionId, bankAccountReference])
}

model AccountPresentation {
  accountId String @id @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reserveEligible Boolean @default(false)
}

model ReserveGoal {
  id Int @id @default(1)
  targetCents BigInt @default(300000)
  updatedAt DateTime @updatedAt
}

model WealthRecord {
  id String @id @default(uuid()) @db.Uuid
  recordedAt DateTime @default(now())
  totalCents BigInt
  coverage String
  idempotencyKey String @unique @db.VarChar(128)
  components WealthRecordComponent[]
  @@index([recordedAt(sort: Desc), id(sort: Desc)])
}

model WealthRecordComponent {
  id String @id @default(uuid()) @db.Uuid
  recordId String @db.Uuid
  record WealthRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  accountId String? @db.Uuid
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  sourceLabel String @db.VarChar(120)
  amountCents BigInt?
  observedAt DateTime?
  sourceType String @db.VarChar(64)
  @@index([recordId])
  @@index([accountId])
}

model BalanceSnapshot {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  account Account @relation(fields: [accountId], references: [id])
  amountCents BigInt
  balanceType String
  observedAt DateTime
  source String
  importRunId String @db.Uuid
  importRun ImportRun @relation(fields: [importRunId], references: [id])
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  kind String
  color String?
  isSystem Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  transactions Transaction[]
  rules CategoryRule[]
  contracts Contract[]
}

model CategoryRule {
  id String @id @default(uuid()) @db.Uuid
  name String
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  matchType String
  text String
  direction String @default("ANY")
  priority Int @default(100)
  isActive Boolean @default(true)
  @@index([isActive, priority])
}

model Transaction {
  id String @id @default(uuid()) @db.Uuid
  createdByImportRunId String? @db.Uuid
  createdByImportRun ImportRun? @relation("CreatedTransactions", fields: [createdByImportRunId], references: [id], onDelete: SetNull)
  accountId String? @db.Uuid
  account Account? @relation(fields: [accountId], references: [id])
  amountCents BigInt
  currency String @default("EUR")
  bookingDate DateTime @db.Date
  valueDate DateTime? @db.Date
  description String
  counterpartyName String?
  counterpartyIban String?
  status String @default("BOOKED")
  categoryId String? @db.Uuid
  categoryOrigin String @default("NONE")
  categoryRuleId String? @db.Uuid
  categoryRuleName String?
  categoryRuleConflict Boolean @default(false)
  classification String?
  contractAutoBlocked Boolean @default(false)
  contractPayment ContractPayment?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isTransfer Boolean @default(false)
  transferGroupId String? @db.Uuid
  transferGroup TransferGroup? @relation(fields: [transferGroupId], references: [id], onDelete: SetNull)
  identities TransactionIdentity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([accountId, bookingDate(sort: Desc), id(sort: Desc)])
  @@index([bookingDate, amountCents])
  @@index([categoryId])
  @@index([createdByImportRunId])
}

model TransactionIdentity {
  id String @id @default(uuid()) @db.Uuid
  accountId String? @db.Uuid
  scope String
  importRunId String? @db.Uuid
  importRun ImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  identityType String
  identityValue String
  transactionId String @db.Uuid
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  @@unique([scope, identityType, identityValue])
  @@index([accountId])
  @@index([identityType, identityValue])
}

model TransferGroup {
  id String @id @default(uuid()) @db.Uuid
  transactions Transaction[]
}

model ImportRun {
  id String @id @default(uuid()) @db.Uuid
  bankConnectionId String? @db.Uuid
  bankConnection BankConnection? @relation(fields: [bankConnectionId], references: [id])
  source String
  status String @default("CREATED")
  startedAt DateTime @default(now())
  finishedAt DateTime?
  importedCount Int @default(0)
  knownCount Int @default(0)
  reviewRequiredCount Int @default(0)
  errorCode String?
  issues ImportIssue[]
  staged StagedRow[]
  balances BalanceSnapshot[]
  identities TransactionIdentity[]
  createdTransactions Transaction[] @relation("CreatedTransactions")
  @@index([startedAt])
}

model ImportIssue {
  id String @id @default(uuid()) @db.Uuid
  runId String @db.Uuid
  run ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rowNumber Int?
  code String
  message String
  candidateIds String[]
  resolved Boolean @default(false)
  resolutionHash String?
  stagedRowId String? @unique @db.Uuid
  stagedRow StagedRow? @relation(fields: [stagedRowId], references: [id], onDelete: SetNull)
}

model StagedRow {
  id String @id @default(uuid()) @db.Uuid
  runId String @db.Uuid
  run ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  accountId String? @db.Uuid
  account Account? @relation(fields: [accountId], references: [id])
  rowNumber Int
  data Json
  issue ImportIssue?
}

model AssignmentReceipt {
  id String @id @db.Uuid
  inputHash String
  result Json
  createdAt DateTime @default(now())
}

model Contract {
  id String @id @default(uuid()) @db.Uuid
  name String
  provider String
  kind String
  suggestionDecision ContractSuggestionDecision?
  accountId String? @db.Uuid
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId String? @db.Uuid
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  startDate DateTime @db.Date
  endDate DateTime? @db.Date
  cancellationDate DateTime? @db.Date
  revisions ContractRevision[]
  payments ContractPayment[]
}

model ContractSuggestionDecision {
  key String @id
  state String
  contractId String? @unique @db.Uuid
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ContractRevision {
  id String @id @default(uuid()) @db.Uuid
  contractId String @db.Uuid
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  effectiveDate DateTime @db.Date
  amountCents BigInt
  intervalMonths Int
  payments ContractPayment[]
  @@unique([contractId, effectiveDate])
}

model ContractPayment {
  id String @id @default(uuid()) @db.Uuid
  contractId String @db.Uuid
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  revisionId String @db.Uuid
  revision ContractRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  dueDate DateTime @db.Date
  transactionId String @unique @db.Uuid
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  source String
  createdAt DateTime @default(now())
  @@unique([contractId, dueDate])
}
